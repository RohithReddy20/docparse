# vLLM endpoint for LightOnOCR-3 (printed by `modal deploy serve/modal_vllm.py`), must end in /v1
LIGHTONOCR_ENDPOINT_URL=https://<workspace>--docparse-lightonocr3-serve.modal.run/v1
LIGHTONOCR_MODEL=lightonocr3

# vLLM endpoint for Infinity-Parser2-Flash (scripts/deploy_infinity.sh); base /v1 or full /v1/chat/completions
INFINITY_ENDPOINT_URL=https://<workspace>--docparse-infly-infinity-parser2-flash-serve.modal.run/v1

# PP-DocLayoutV3 layout server (`modal deploy serve/modal_paddle_layout.py`); no /v1 suffix
PADDLE_LAYOUT_ENDPOINT_URL=https://<workspace>--docparse-paddle-layout-layoutserver-web.modal.run

# Optional: faster HF dataset downloads
# HF_TOKEN=
